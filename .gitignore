# ---- runtime state (regenerated by openclaw on launch) ----
npm/node_modules/
*.sqlite
*.sqlite-shm
*.sqlite-wal
agents/*/sessions/
tui/last-session.json
gateway-supervisor-restart-handoff.json
update-check.json
discord/command-deploy-cache.json
plugins/installs.json
workspace/.openclaw/

# ---- secrets (must be generated per-machine, never committed) ----
identity/device.json
identity/device-auth.json
devices/paired.json
devices/pending.json
service-env/
auth-profiles.json
openclaw.json
.env
.env.*
!.env.example

# ---- generated shell completions ----
completions/openclaw.fish
completions/openclaw.zsh
completions/openclaw.ps1
completions/openclaw.bash

# ---- memory / logs ----
memory/
logs/
tmp/

# ---- editor / OS ----
.DS_Store
*.bak
*.bak.*
*.last-good
